<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/portrait.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>Portrait Camera</Product>
    <Description>A simple portrait webcam for desktop calls.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <Content Include="../../assets/models/*" Link="models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/portrait.ico" Link="portrait.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../build/native-x64/Release/PortraitCamera.Native.dll" Link="PortraitCamera.Native-$(Version).dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../build/native-x64/Release/PortraitCamera.Windows.dll" Link="PortraitCamera.Windows.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
